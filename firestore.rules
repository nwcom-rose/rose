rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 管理員判定：以 email 白名單為權威來源（與前端 ADMIN_EMAILS 一致）
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in ['istage.eason@gmail.com', 'nwcom.rose@gmail.com'];
    }

    match /config/cockpit {
      // 駕駛艙佈局：所有人可讀取，僅管理員可寫入
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{docId} {
      // 其他設定檔（位階、規則、一般設定）：僅管理員可讀寫
      allow read, write: if isAdmin();
    }

    match /users/{userId} {
      // 讀取：管理員可讀取全部；一般會員只能讀取自己
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      // 寫入：管理員可寫入全部；一般會員只能寫入自己
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    match /users/{userId}/interactions/{interactionId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }
  }
}
